// DONE 9.0 migration: Line 102: You very likely need to rewrite "VARIABLE.label" to "Neos.Node.label(VARIABLE)". We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
// DONE 9.0 migration: Line 109: You very likely need to rewrite "VARIABLE.label" to "Neos.Node.label(VARIABLE)". We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
prototype(UpAssist.MegaMenu:Component.Molecule.Menu.Item) < prototype(Neos.Fusion:Component) {
  @propTypes {
    item = ${PropTypes.any}
    enableItemLabel = ${PropTypes.boolean}
    itemLabel = ${PropTypes.string}
    content = ${PropTypes.any}
  }

  item = null
  enableItemLabel = false
  itemLabel = ''
  content = null

  @private {
    // Resolve node:// and asset:// links once, in the context of the menu item node.
    // Neos.Neos:NodeLink overrides the "node" context variable, so resolving inside it uses the wrong context node.
    targetUri = ${props.item && (String.startsWith(props.item, 'node://') || String.startsWith(props.item, 'asset://')) ? String.split(props.item, '#')[0] : null}
    target = ${private.targetUri ? Neos.Link.convertUriToObject(private.targetUri, node) : null}
    targetNode = ${private.target && Type.instance(private.target, 'Neos\\ContentRepository\\Core\\Projection\\ContentGraph\\Node') ? private.target : null}
    targetAsset = ${private.target && Type.instance(private.target, 'Neos\\Media\\Domain\\Model\\AssetInterface') ? private.target : null}
    assetUri = ${private.targetAsset ? Neos.Link.resolveAssetUri(private.targetUri) : null}
    targetLabel = ${private.targetNode ? Neos.Node.label(private.targetNode) : (private.targetAsset ? (private.targetAsset.title || private.targetAsset.resource.filename) : '')}
    label = ${props.enableItemLabel && props.itemLabel ? props.itemLabel : private.targetLabel}
  }

  renderer = UpAssist.MegaMenu:ExtendedRenderer {
    classList = Neos.Fusion:DataStructure {
      1 = ${Configuration.setting('UpAssist.MegaMenu.defaultClasses.menu') + '__item'}
      2 = ${Configuration.setting('UpAssist.MegaMenu.defaultClasses.menu') + '--has-sub'}
      2.@if.hasContent = ${props.content}
      3 = Neos.Fusion:Case {
        currentPage {
          condition = ${private.targetNode && documentNode.aggregateId.value == private.targetNode.aggregateId.value}
          renderer = ${Configuration.setting('UpAssist.MegaMenu.defaultClasses.menu') + '__item--active'}
        }

        default {
          condition = true
          renderer = ${Configuration.setting('UpAssist.MegaMenu.defaultClasses.menu') + '__item--normal'}
        }
      }
    }
    item.@process.convert = Neos.Fusion:Case {
      empty {
        condition = ${!props.item}
        renderer = afx`
          <span>{props.enableItemLabel ? props.itemLabel : ''}</span>
        `
      }
      singleHash {
        condition = ${!String.startsWith(props.item, 'node://') && !String.startsWith(props.item, 'asset://') && String.indexOf(props.item, '#') >= 0}
        renderer = Neos.Fusion:Case {
          inBackend {
            condition = ${renderingMode.isEdit}
            renderer = afx`
              <span>{props.enableItemLabel ? props.itemLabel : String.firstLetterToUpperCase(String.split(props.item, '#')[1])}</span>
            `
          }
          default {
            condition = ${true}
            renderer = afx`
              <a href={props.item}
                 title={String.firstLetterToUpperCase(String.split(props.item, '#')[1])}>{props.enableItemLabel ? props.itemLabel : String.firstLetterToUpperCase(String.split(props.item, '#')[1])}</a>
            `
          }
        }
      }
      nodeWithHash {
        condition = ${private.targetNode && String.indexOf(props.item, '#') > 0}
        renderer = Neos.Fusion:Case {
          inBackend {
            condition = ${renderingMode.isEdit}
            renderer = afx`
              <span>{props.enableItemLabel ? props.itemLabel : String.firstLetterToUpperCase(String.split(props.item, '#')[1])}</span>
            `
          }
          default {
            condition = ${true}
            renderer = Neos.Fusion:Component {
              uri = Neos.Neos:NodeUri {
                node = ${private.targetNode}
                @process.append = ${(private.targetNode.aggregateId.value != documentNode.aggregateId.value ? value : '') + '#' + String.split(props.item, '#')[1]}
              }
              title = ${props.enableItemLabel ? props.itemLabel : String.firstLetterToUpperCase(String.split(props.item, '#')[1])}
              renderer = afx`
                <a href={props.uri} title={props.title}>{props.title}</a>
              `
            }
          }
        }
      }
      externalLink {
        condition = ${String.startsWith(props.item, 'http')}
        renderer = Neos.Fusion:Case {
          inBackend {
            condition = ${renderingMode.isEdit}
            renderer = afx`
              <span>{props.enableItemLabel ? props.itemLabel : props.item}</span>
            `
          }
          default {
            condition = ${true}
            renderer = Neos.Fusion:Component {
              uri = ${props.item}
              title = ${props.enableItemLabel ? props.itemLabel : props.item}
              renderer = afx`
                <a href={props.uri} title={props.title} target="_blank">{props.title}</a>
              `
            }
          }
        }
      }
      nodeLink {
        condition = ${private.targetNode}
        renderer = Neos.Fusion:Case {
          inBackend {
            condition = ${renderingMode.isEdit}
            renderer = afx`
              <span>{private.label}</span>
            `
          }
          default {
            condition = true
            renderer = afx`
              <Neos.Neos:NodeLink node={private.targetNode} content={private.label} />
            `
          }
        }
      }
      assetLink {
        condition = ${private.targetAsset}
        renderer = Neos.Fusion:Case {
          inBackend {
            condition = ${renderingMode.isEdit}
            renderer = afx`
              <span>{private.label}</span>
            `
          }
          default {
            condition = true
            renderer = afx`
              <a href={private.assetUri} title={private.label} target="_blank">{private.label}</a>
            `
          }
        }
      }
      unresolved {
        // node:// or asset:// target that no longer exists or is not visible: render the label without a link
        condition = ${private.targetUri}
        renderer = afx`
          <span>{private.label}</span>
        `
      }
      default {
        // Any other URI (mailto:, tel:, relative paths)
        condition = ${true}
        renderer = Neos.Fusion:Case {
          inBackend {
            condition = ${renderingMode.isEdit}
            renderer = afx`
              <span>{props.enableItemLabel && props.itemLabel ? props.itemLabel : props.item}</span>
            `
          }
          default {
            condition = true
            renderer = afx`
              <a href={props.item} title={props.enableItemLabel && props.itemLabel ? props.itemLabel : props.item}>{props.enableItemLabel && props.itemLabel ? props.itemLabel : props.item}</a>
            `
          }
        }
      }
    }

    renderer = afx`
      <span class={props.classList}>
        {props.item}
        <nav class={Configuration.setting('UpAssist.MegaMenu.defaultClasses.menu') + '_sub'} @if={props.content}>
          <Neos.Neos:ContentCollectionRenderer>{props.content}</Neos.Neos:ContentCollectionRenderer>
        </nav>
      </span>
    `
  }
}
